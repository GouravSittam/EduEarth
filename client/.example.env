NEXT_PUBLIC_SERVER_URL="http://localhost:6969"

# Supabase auth (publishable/anon key only — never put secret keys in NEXT_PUBLIC_ vars)
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# The eco-assistant's Gemini key lives on the API server (GEMINI_API_KEY),
# not here — anything prefixed NEXT_PUBLIC_ is shipped to every browser.
